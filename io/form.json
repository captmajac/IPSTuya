    {
      "type": "Button",
      "caption": "Update now",
      "onClick": "Tuya_Update($id);"
    }
  ],
  "status": [
    {
      "code": 104,
      "icon": "inactive",
      "caption": "Enter Access ID, Access secret, Base URL and App ID"
