{
  "elements": [
    {
      "name": "AccessKey",
      "type": "PasswordTextBox",
      "caption": "Access ID"
    },
    {
      "name": "SecretKey",
      "type": "PasswordTextBox",
      "caption": "Access secret"
    },
    {
      "name": "BaseUrl",
      "type": "ValidationTextBox",
      "caption": "Base URL (e.g. https://openapi.tuyaeu.com)"
    },
    {
