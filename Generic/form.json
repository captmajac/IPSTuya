{
  "elements": [
    {
      "name": "DeviceID",
      "type": "ValidationTextBox",
      "caption": "Device ID"
    },
    {
      "name": "LocalKey",
      "type": "ValidationTextBox",
      "caption": "Local key"
    }
  ],
  "actions": [
    {
      "type": "PopupButton",
      "caption": "Search device",
      "onClick": "Tuya_SearchModules($id);",
      "popup": {
        "caption": "Tuya devices",
        "items": [
          {
            "type": "List",
            "name": "Devices",
            "caption": "Devices in the Tuya cloud",
            "rowCount": 10,
            "add": false,
            "delete": false,
            "columns": [
              {
                "caption": "ID",
                "name": "ID",
                "width": "200px",
                "add": ""
              },
              {
                "caption": "Online",
                "name": "Online",
                "width": "70px",
                "add": ""
              },
              {
                "caption": "Name",
                "name": "Name",
                "width": "auto",
                "add": ""
              },
              {
                "caption": "Model",
                "name": "Model",
                "width": "300px",
                "add": ""
              },
              {
                "caption": "Local key",
                "name": "LocalKey",
                "width": "200px",
                "add": ""
              }
            ],
            "values": []
          },
          {
            "type": "Button",
            "caption": "Apply selected",
            "onClick": "Tuya_SetSelectedModul($id, $Devices);"
          },
          {
            "type": "Label",
            "caption": "Apply selected enters Device ID and Local key in the form. Close this dialog and click Apply to save."
          }
        ]
      }
    }
  ]
}
